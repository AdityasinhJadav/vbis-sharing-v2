# ============================================
# Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to version control!

# API Configuration (REQUIRED)
# Backend API base URL
# For development: http://localhost:4000/api
# For production: https://your-backend-domain.com/api
VITE_API_BASE=http://localhost:4000/api

# Flask API URL (REQUIRED)
# Flask face recognition service URL
# For development: http://localhost:5000/api
# For production: https://your-flask-domain.com/api
VITE_FLASK_API_URL=http://localhost:5000/api

# Cloudinary Configuration (REQUIRED)
# Get these from: https://cloudinary.com/console
# Cloud name from your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
# Upload preset name (create in Cloudinary Dashboard > Settings > Upload presets)
# Should be set to "Unsigned" for frontend uploads
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Optional: Flask Service Secret (for direct Flask API calls)
# Only needed if making direct calls to Flask API from frontend
# Must match FLASK_SERVICE_SECRET in Flask backend
VITE_FLASK_SERVICE_SECRET=

# Optional: App Configuration
VITE_APP_NAME=FaceMatch
VITE_APP_VERSION=1.0.0

# Optional: Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Optional: Performance Settings
VITE_MAX_FILE_SIZE_MB=10
VITE_MAX_PHOTOS_PER_UPLOAD=50
VITE_CACHE_TTL_MINUTES=5

# Firebase Configuration (Optional - if using Firebase)
# You can find these in your Firebase Console > Project Settings > General > Your apps
# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id_here
# VITE_FIREBASE_APP_ID=your_app_id_here
