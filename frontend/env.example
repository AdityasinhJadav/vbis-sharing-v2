# Firebase Configuration
# Copy this file to .env and replace with your actual Firebase project credentials
# You can find these in your Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Cloudinary Configuration
# You can find these in your Cloudinary Dashboard > Settings > API Keys
# Sign up at https://cloudinary.com/ if you don't have an account

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
